# =============================================================================
# Nautilus 内网私有化配置模板
#   cp .env.private.example .env.private  然后按需修改
# 纯内网运行，不含任何公网地址/凭据。
# =============================================================================

# ---- 数据库 / 缓存 ----------------------------------------------------------
# !!! 下方为弱默认口令，仅供内网测试；生产部署务必替换为强随机口令 !!!
POSTGRES_PASSWORD=nautilus2024
DATABASE_URL=postgresql://nautilus_user:nautilus2024@postgres:5432/nautilus_production
REDIS_URL=redis://redis:6379/0

# ---- 私有链 (geth Clique POA) ----------------------------------------------
BLOCKCHAIN_NETWORK=privatechain
PRIVATE_RPC=http://geth:8545
PRIVATE_CHAIN_ID=13370

# 私链签名/部署/服务端签名账户（三处同一把私钥）。
# 下方为公开测试助记词 "test ... junk" 的 account0（地址 0xf39Fd6...）。
# !!! 仅供内网测试，生产部署前务必更换为公司自管私钥 !!!
SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- 合约地址 --------------------------------------------------------------
# 以下为用上面测试账户(0xf39Fd6...)在全新私链上、按 deploy_private.js 顺序部署的
# 确定性地址。若更换部署账户/部署顺序，请用 deployed_private.json 实际地址覆盖。
HUA_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NAU_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
REWARD_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
TASK_CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
IDENTITY_CONTRACT_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
WALLET_REGISTRY_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707

# ---- 托管钱包 --------------------------------------------------------------
# 32 字节 base64 主密钥。生成：openssl rand -base64 32
# 留空则后端以随机密钥运行（仅 dev，重启后已存私钥无法解密！生产必须固定）。
WALLET_MASTER_KEY=

# ---- 私有大模型 (OpenAI 兼容协议) ------------------------------------------
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=your-private-llm-key
LLM_MODEL=your-model-name

# ---- 安全 ------------------------------------------------------------------
# !!! 生产必须替换：openssl rand -base64 32 生成后填入，切勿沿用占位值 !!!
JWT_SECRET=change-me-run-openssl-rand-base64-32

# ---- 平台开关 --------------------------------------------------------------
AUTONOMOUS_LOOP_ENABLED=true
PROPOSAL_INTELLIGENCE_LEVEL=2
# 内网禁用一切外部联网搜索（DeerFlow 的 DDGS 等），确保零公网外连
DISABLE_WEB_SEARCH=true
ENVIRONMENT=production
